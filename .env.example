# Nomad Phase 1 environment (CLAUDE.md §14)
# Copy to .env.local and fill in. Never commit .env.local.

# ── Supabase ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server only — never expose to the client

# ── Map ────────────────────────────────────────────────────────────────────
# OpenFreeMap (no key needed) or a MapTiler style URL.
# Do NOT use the Google Maps JS SDK (cost + ToS coupling, §3).
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# ── Drive time (§8) ────────────────────────────────────────────────────────
DRIVE_TIME_PROVIDER=heuristic         # heuristic | osrm | mapbox
OSRM_URL=
MAPBOX_TOKEN=

# ── Seeding / enrichment (§7) ──────────────────────────────────────────────
# Places is TRANSIENT enrichment only: persist place_id, never other Places content.
GOOGLE_PLACES_API_KEY=

# ── Anti-abuse (§6.5) ──────────────────────────────────────────────────────
# Salt for device_hash. Generate with: openssl rand -hex 32
DEVICE_HASH_SALT=

# ── Stripe (§13) ───────────────────────────────────────────────────────────
# PLACEHOLDERS — UNUSED in Phase 1. No SDK calls, no billing logic.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
